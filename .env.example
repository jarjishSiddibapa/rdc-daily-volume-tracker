# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-strong-random-hex-key

# Set to "true" when running behind HTTPS (required for production)
SESSION_COOKIE_SECURE=false

# ── Shared-server runtime tuning ─────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8089
WAITRESS_THREADS=4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=10
REPORT_CACHE_SECONDS=10
SCHEDULER_ENABLED=true
LOG_ALL_REQUESTS=false
SLOW_REQUEST_MS=750
HEARTBEAT_ENABLED=false

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=daily_volume_tracker

# ── Oracle ERP (read-only connection) ────────────────────────────────────────
ORACLE_USER=your-oracle-user
ORACLE_PASSWORD=your-oracle-password
ORACLE_HOST=192.168.x.x
ORACLE_PORT=1521
ORACLE_SERVICE=your-oracle-service-name
# Optional: set this only when using python-oracledb thick mode
ORACLE_CLIENT_PATH=C:\oracle\instantclient

# ── Admin seed (only used on first run when users table is empty) ─────────────
# If not set, a random password is printed to stdout on first boot.
ADMIN_INITIAL_PASSWORD=change-me-immediately
